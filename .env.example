# Copy to .env and edit. Never commit .env.

# Admin account, created on first start. Remove the password line afterwards.
IPTV_ADMIN_USER=admin
IPTV_ADMIN_PASSWORD=

# Signs login cookies and hides provider logins in URLs. Generate once:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to let the app create one in data/playlists/.flask_secret_key.
FLASK_SECRET_KEY=

TZ=America/Los_Angeles
IPTV_HTTP_PORT=8080
IPTV_HTTPS_PORT=8443
IPTV_SITE_ADDRESS=:80

# Concurrent relay connections per provider, e.g. "My Provider=1,Other=2"
PROVIDER_LIMITS=

# Optional: Postgres (see docker-compose.yml)
# REQUIRE_POSTGRES=1
# DATABASE_URL=postgresql://iptv:change-me@db:5432/iptv
# POSTGRES_PASSWORD=change-me

# Optional: LLDAP login (users in groups app_stream / lldap_admin)
# LLDAP_AUTH_URL=http://lldap:17170

# Optional: InfluxDB stream metrics
# INFLUXDB_URL=http://influxdb:8086
# INFLUXDB_TOKEN=
# INFLUXDB_ORG=
# INFLUXDB_BUCKET=
